  "intro": [
    {
      "term": "PLSV",
      "text": "Persamaan Linear Satu Variabel: ada tanda =, satu variabel, dan pangkat variabelnya satu."
    },
    {
      "term": "Contoh",
      "text": "x + 3 = 10 adalah PLSV. x² = 9 bukan PLSV, karena pangkat x dua."
    },
    {
      "term": "Ruas",
      "text": "Bagian kiri dan kanan tanda = disebut ruas."
    },
    {
      "term": "Seimbang",
      "text": "Apa pun yang kamu lakukan pada ruas kiri, lakukan juga pada ruas kanan."
    }
  ],
