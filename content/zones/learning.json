      "pages": [
        {
          "kind": "explain",
          "title": "Apa itu PLSV?",
          "text": [
            "PLSV adalah Persamaan Linear Satu Variabel.",
            "Persamaan adalah kalimat matematika dengan tanda sama dengan (=).",
            "Linear artinya pangkat variabelnya satu.",
            "Satu variabel artinya hanya ada satu huruf, misalnya x."
          ],
          "visual": {
            "type": "table",
            "headers": [
              "Kalimat",
              "PLSV?",
              "Alasan"
            ],
            "rows": [
              [
                "x + 3 = 10",
                "Ya",
                "satu variabel, pangkat satu"
              ],
              [
                "x² = 9",
                "Bukan",
                "pangkat x dua"
              ],
              [
                "x + y = 5",
                "Bukan",
                "ada dua variabel"
              ],
              [
                "3 + 4 = 7",
                "Bukan",
                "tidak ada variabel"
              ]
            ]
          }
        },
        {
          "kind": "example",
          "title": "Contoh: mengenali PLSV",
          "lines": [
            {
              "text": "Perhatikan persamaan ini.",
              "eq": "2*x - 1 = 7"
            },
            {
              "text": "Ada tanda =. Jadi ini persamaan."
            },
            {
              "text": "Hanya ada satu variabel, yaitu x."
            },
            {
              "text": "Pangkat x adalah satu. Jadi 2x − 1 = 7 adalah PLSV."
            }
          ]
        },
        {
          "kind": "summary",
          "points": [
            "PLSV punya tanda =.",
            "PLSV punya tepat satu variabel.",
            "Pangkat variabelnya satu."
          ]
        },
